{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "corecare-platform",
	"main": "src/index.js",
	"compatibility_date": "2026-08-03",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/auth/portal-login"
		]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05
		}
	},
	"vars": {
		"CORECARE_ENVIRONMENT": "production"
	},
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"services": [
		{ "binding": "CORECARE_CARE", "service": "corecare-care" },
		{ "binding": "CORECARE_POS", "service": "corecare-pos" },
		{ "binding": "CORECARE_GARAGE", "service": "corecare-garage" },
		{ "binding": "CORECARE_CAMPSITE", "service": "corecare-campsite" },
		{ "binding": "CORECARE_FINANCE", "service": "corecare-finance" }
	],
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "corecare-platform-secure-storage"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "corecare-platform",
			"database_id": "b9f64a82-6e14-4b4c-837e-f050022aba29"
		}
	],
	"env": {
		"staging": {
			"name": "corecare-platform-staging",
			"vars": {
				"CORECARE_ENVIRONMENT": "staging"
			},
			"triggers": {
				"crons": []
			},
			"services": [
				{ "binding": "CORECARE_CARE", "service": "corecare-care" },
				{ "binding": "CORECARE_POS", "service": "corecare-pos" },
				{ "binding": "CORECARE_GARAGE", "service": "corecare-garage" },
				{ "binding": "CORECARE_CAMPSITE", "service": "corecare-campsite" },
				{ "binding": "CORECARE_FINANCE", "service": "corecare-finance" }
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "corecare-platform-staging",
					"database_id": "037bbfc2-1937-4a58-8836-27cade965edd"
				}
			],
			"r2_buckets": [
				{
					"binding": "ATTACHMENTS",
					"bucket_name": "corecare-platform-staging-secure-storage"
				}
			]
		}
	}
}
