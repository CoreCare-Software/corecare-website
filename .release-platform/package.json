{
  "name": "corecare-platform",
  "version": "1.11.0",
  "private": true,
  "description": "CoreCare software-owner command centre and cross-product platform administration",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:staging": "wrangler deploy --env staging",
    "check": "wrangler deploy --dry-run --env=\"\"",
    "test": "npm run test:unit && npm run test:runtime",
    "test:unit": "node --test test/*.test.js",
    "test:runtime": "vitest run --config vitest.config.js",
    "types": "wrangler types",
    "migrations:check": "node scripts/check-migrations.js",
    "verify": "npm run migrations:check && npm test && npm run check",
    "db:migrate:local": "wrangler d1 migrations apply corecare-platform --local",
    "db:migrate:remote": "wrangler d1 migrations apply corecare-platform --remote --env=\"\"",
    "db:migrate:staging": "wrangler d1 migrations apply corecare-platform-staging --remote --env staging"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@types/node": "^26.1.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=20"
  }
}
