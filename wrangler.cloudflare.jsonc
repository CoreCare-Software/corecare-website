{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "corecare-website",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "login.corecaresystems.co.uk", "custom_domain": true }
  ],
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/_corecare-static/*",
      "/assets/*",
      "/_next/static/*"
    ]
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "CORECARE_OWNER_EMAILS": "chriswarman21@yahoo.co.uk,ekgeneralstore@gmail.com",
    "TURNSTILE_HOSTNAMES": "corecaresystems.co.uk,www.corecaresystems.co.uk,login.corecaresystems.co.uk"
  },
  "services": [
    {
      "binding": "CORECARE_PLATFORM_PORTAL",
      "service": "corecare-platform",
      "entrypoint": "PortalBroker"
    },
    {
      "binding": "CORECARE_PLATFORM_AUTOMATION",
      "service": "corecare-platform"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corecare-website",
      "database_id": "658f7b26-ac27-45de-8228-373dc6318081",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*.sql"
    }
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "corecare-website-staging",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "images": {
        "binding": "IMAGES"
      },
      "services": [
        {
          "binding": "CORECARE_PLATFORM_PORTAL",
          "service": "corecare-platform-staging",
          "entrypoint": "PortalBroker"
        },
        {
          "binding": "CORECARE_PLATFORM_AUTOMATION",
          "service": "corecare-platform-staging"
        }
      ],
      "vars": {
        "CORECARE_OWNER_EMAILS": "chriswarman21@yahoo.co.uk,ekgeneralstore@gmail.com",
        "TURNSTILE_HOSTNAMES": "corecare-website-staging.cselectricalservices11.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "corecare-website-staging",
          "database_id": "f1e68871-6444-411e-815a-9f12eb57b6b9",
          "migrations_dir": "drizzle",
          "migrations_pattern": "drizzle/*.sql"
        }
      ]
    }
  }
}
