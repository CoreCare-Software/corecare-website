{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "corecare-website",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "login.corecaresystems.co.uk", "custom_domain": true }
  ],
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/*", "/_next/static/*"]
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "CORECARE_PLATFORM",
      "service": "corecare-platform",
      "entrypoint": "PortalBroker"
    },
    {
      "binding": "CORECARE_PLATFORM_AUTOMATION",
      "service": "corecare-platform"
    }
  ],
  "vars": {
    "CORECARE_OWNER_EMAILS": "chriswarman21@yahoo.co.uk,ekgeneralstore@gmail.com",
    "TURNSTILE_HOSTNAMES": "corecaresystems.co.uk,www.corecaresystems.co.uk,login.corecaresystems.co.uk"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corecare-platform",
      "database_id": "b9f64a82-6e14-4b4c-837e-f050022aba29"
    }
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
