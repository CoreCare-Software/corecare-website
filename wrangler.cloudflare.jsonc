{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "corecare-website",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "./dist/client"
  },
  "services": [
    {
      "binding": "CORECARE_PLATFORM_PORTAL",
      "service": "corecare-platform",
      "entrypoint": "PortalBroker"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corecare-platform",
      "database_id": "b9f64a82-6e14-4b4c-837e-f050022aba29"
    }
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
