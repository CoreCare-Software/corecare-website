{
  "name": "corecare-systems-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "deploy:cloudflare": "wrangler deploy --config wrangler.cloudflare.jsonc",
    "deploy:staging": "wrangler deploy --config wrangler.cloudflare.jsonc --env staging",
    "check": "wrangler deploy --dry-run --config wrangler.cloudflare.jsonc --env=\"\"",
    "check:staging": "wrangler deploy --dry-run --config wrangler.cloudflare.jsonc --env staging",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts --max-warnings=0",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.cloudflare.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.cloudflare.jsonc",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --config wrangler.cloudflare.jsonc --env staging",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.45",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "type": "module",
  "overrides": {
    "undici": "^7.29.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
