# Public product origins. Replace with branded subdomains after DNS activation.
CORECARE_CARE_ORIGIN=https://care.corecaresystems.co.uk
CORECARE_CAMPSITE_ORIGIN=https://campsites.corecaresystems.co.uk
CORECARE_FINANCE_ORIGIN=https://finance.corecaresystems.co.uk
CORECARE_GARAGE_ORIGIN=https://garage.corecaresystems.co.uk
CORECARE_POS_ORIGIN=https://pos.corecaresystems.co.uk
CORECARE_OWNER_EMAILS=chriswarman21@yahoo.co.uk,ekgeneralstore@gmail.com

# The Platform login and automation receivers are private Cloudflare service bindings.

# A secret of at least 32 random characters. Store the production value as a
# Cloudflare Worker secret; it encrypts internal automation credentials at rest.
WEBSITE_TOKEN_ENCRYPTION_KEY=

# The site key is public; the production secret is stored only in Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEHZA3fx6EQ1VoTI
TURNSTILE_SITE_KEY=0x4AAAAAAEHZA3fx6EQ1VoTI
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=corecaresystems.co.uk,www.corecaresystems.co.uk,login.corecaresystems.co.uk

# Staging only: Cloudflare's official always-pass Turnstile test sitekey/secret
# (https://developers.cloudflare.com/turnstile/troubleshooting/testing/). These
# values must never be used outside env.staging; production keeps its real
# site key and secret above. A production secret rejects the test token and a
# test secret rejects a real token, so this cannot silently degrade production.
# TURNSTILE_SITE_KEY=1x00000000000000000000BB
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA
